{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start database",
      "type": "shell",
      "command": "pnpm db:start && pnpm db:migrate",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Start frontend",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Start project",
      "dependsOn": [
        "Start database",
        "Start frontend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
