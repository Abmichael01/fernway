# PostgreSQL connection. Leave unset in development to use the project's local
# database (127.0.0.1:5729, started with `pnpm db:start`). Required in production.
DATABASE_URL=

# Extra origins allowed to send unsafe requests (comma-separated). Defaults to
# http://localhost:4729,http://127.0.0.1:4729.
TRUSTED_ORIGINS=

# Admin login, created or updated by `pnpm db:seed` run through envsafe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Infura API key for real on-chain balance querying in Fernway Vault.
# If omitted, Fernway automatically uses high-availability public Ethereum RPC.
INFURA_API_KEY=
INVEST_PUBLIC_URL=
